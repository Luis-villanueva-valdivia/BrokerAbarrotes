center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="274" y="84" width="312" height="17" as="geometry"/></mxCell><mxCell id="c64" value="&lt;i&gt;«package»&lt;/i&gt;&lt;br&gt;&lt;b&gt;comun&lt;/b&gt;&lt;br&gt;(lo usan todos los componentes)&lt;br&gt;Solicitud(id: UUID, servicio, operacion, parametros: Map&amp;lt;String,String&amp;gt;, fechaHora)&lt;br&gt;Respuesta(idSolicitud, resultado, estado, mensajeError, fechaHora) · exito(...) · error(...)&lt;br&gt;EstadoRespuesta { EXITO, SERVICIO_DESCONOCIDO, PARAMETRO_INVALIDO, ERROR_PROVEEDOR, TIMEOUT }&lt;br&gt;«interface» ProveedorServicio { Respuesta ejecutar(Solicitud) }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;align=center;fontFamily=Helvetica;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="740" height="135" as="geometry"/></mxCell><mxCell id="c65" value="Nivel 1: cliente, broker y proveedores viven en el mismo proceso.&lt;br&gt;• ClienteApp nunca conoce a los proveedores: solo llama a Broker.enviar(Solicitud).&lt;br&gt;• Broker busca el proveedor en RegistroServicios por el nombre del servicio.&lt;br&gt;• Cualquier RuntimeException del proveedor se convierte en Respuesta ERROR_PROVEEDOR.&lt;br&gt;• Puertos: pEnviar (provee), pProveedor (requiere ProveedorServicio), pServicio (provee)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff8c4;strokeColor=#000000;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="740" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
