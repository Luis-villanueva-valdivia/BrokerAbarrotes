t;b&gt;abarrotes&lt;/b&gt;&lt;br&gt;&lt;br&gt;ProductoDAO&lt;br&gt;VentaDAO&lt;br&gt;ClienteDAO&lt;br&gt;&lt;br&gt;ConexionDB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#000000;fontSize=11;verticalAlign=middle;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1460" y="150" width="140" height="260" as="geometry"/></mxCell><mxCell id="c72" value="" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;strokeColor=#000;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;dashed=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="180" as="sourcePoint"/><mxPoint x="1460" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c73" value="" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;strokeColor=#000;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;dashed=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="280" as="sourcePoint"/><mxPoint x="1460" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c74" value="" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;strokeColor=#000;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;dashed=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="380" as="sourcePoint"/><mxPoint x="1460" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c75" value="data/tienda.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="460" width="120" height="80" as="geometry"/></mxCell><mxCell id="c76" value="" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;strokeColor=#000;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;dashed=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1530" y="410" as="sourcePoint"/><mxPoint x="1530" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c77" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;&lt;b&gt;NodoProveedores&lt;/b&gt;&lt;br&gt;main(hostBroker) · iniciarServidor(...)&lt;br&gt;aceptar(...) · atender(...) · registrar(...)&lt;br&gt;synchronized(accesoBaseDatos)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf6e3;strokeColor=#000000;fontSize=10;verticalAlign=middle;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1170" y="680" width="300" height="120" as="geometry"/></mxCell><mxCell id="c78" value="" style="shape=component;align=left;spacingLeft=36;rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1448" y="686" width="16" height="14" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1113.0" y="733.0" width="14" height="14" as="geometry"/></mxCell><mxCell id="c80" value="registro" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="1091" y="718" width="58" height="17" as="geometry"/></mxCell><mxCell id="c81" value="" style="endArrow=none;endFill=0;html=1;rounded=0;fontSize=10;strokeColor=#000;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;dashed=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1127" y="740" as="sourcePoint"/><mxPoint x="1170" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c82" value="" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;strokeColor=#000;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;dashed=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1113" y="740" as="sourcePoint"/><mxPoint x="433" y="202" as="targetPoint"/><Array as="points"><mxPoint x="400" y="740"/><mxPoint x="400" y="202"/></Array></mxGeometry></mxCell><mxCell id="c83" value='MensajeRegistro {"tipo":"REGISTRAR", servicio, host, puerto}  →  Respuesta EXITO "Servicio registrado"' style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="440" y="746" width="640" height="17" as="geometry"/></mxCell><mxCell id="c84" value="Nivel 2: cada parte corre en un proceso distinto y se comunica por TCP con una línea JSON por mensaje (MarshallerJson / Gson).&lt;br&gt;• El cliente solo conoce el puerto 5000 del broker; el broker conoce host:puerto de cada proveedor por el registro dinámico.&lt;br&gt;• ProveedorRemoto adapta un proveedor de red a ProveedorServicio: el Broker es el mismo del nivel 1.&lt;br&gt;• Si el proveedor no responde en 2000 ms reintenta hasta 2 veces; SocketTimeoutException → TIMEOUT, otra IOException → ERROR_PROVEEDOR.&lt;br&gt;• Si NodoProveedores se reinicia, el broker sustituye al proveedor anterior (registrarProveedor → sustituir)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff8c4;strokeColor=#000000;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1080" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
