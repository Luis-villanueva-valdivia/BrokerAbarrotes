ter;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000;" vertex="1" parent="1"><mxGeometry x="185" y="938" width="120" height="30" as="geometry"/></mxCell><mxCell id="c63" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;strokeColor=#000;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="155" y="1004" as="sourcePoint"/><mxPoint x="160" y="1022" as="targetPoint"/><Array as="points"><mxPoint x="189" y="1004"/><mxPoint x="189" y="1022"/></Array></mxGeometry></mxCell><mxCell id="c64" value='20: mostrar(...): "TIMEOUT · Sin respuesta del proveedor…"' style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="195" y="1004" width="368" height="17" as="geometry"/></mxCell><mxCell id="c72" value="ProveedorRemoto.ejecutar repite el bloque hasta MAX_REINTENTOS = 2 veces: 3 intentos × 2000 ms ≈ 6 s.&lt;br&gt;SocketTimeoutException → EstadoRespuesta.TIMEOUT; cualquier otra IOException (p. ej. NodoProveedores apagado) → ERROR_PROVEEDOR.&lt;br&gt;El broker no se cae: responde al cliente y sigue atendiendo otras conexiones en sus hilos.&lt;br&gt;El ClienteRemoto espera hasta 10000 ms (TIEMPO_LECTURA_MS), así que sí alcanza a recibir la respuesta TIMEOUT." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff8c4;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="1050" width="1000" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
